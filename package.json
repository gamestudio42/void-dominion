{
  "name": "void-dominion",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter @void-dominion/game dev",
    "build": "pnpm --filter @void-dominion/game build",
    "preview": "pnpm --filter @void-dominion/game preview",
    "typecheck": "tsc -p tsconfig.sim.json && tsc -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@void-dominion/content": "workspace:*",
    "@void-dominion/kernel": "workspace:*",
    "@void-dominion/simulation": "workspace:*",
    "eslint": "^9.39.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  }
}
