{
  "name": "void-dominion",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter @void-dominion/game dev",
    "build": "pnpm --filter @void-dominion/game build",
    "preview": "pnpm --filter @void-dominion/game preview",
    "typecheck": "tsc -p tsconfig.sim.json && tsc -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "sim": "vitest run packages/simulation/test/arena.test.ts",
    "bench": "node --experimental-transform-types --no-warnings tools/bench/arena.ts",
    "bench:view": "node --experimental-transform-types --no-warnings tools/bench/view.ts",
    "arena": "node --experimental-transform-types --no-warnings tools/arena/match.ts",
    "arena:bench": "node --experimental-transform-types --no-warnings tools/arena/benchmark.ts",
    "arena:replay": "node --experimental-transform-types --no-warnings tools/arena/replay.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@void-dominion/agent": "workspace:*",
    "@void-dominion/agent-sdk": "workspace:*",
    "@void-dominion/arena": "workspace:*",
    "@void-dominion/content": "workspace:*",
    "@void-dominion/kernel": "workspace:*",
    "@void-dominion/net": "workspace:*",
    "@void-dominion/protocol": "workspace:*",
    "@void-dominion/simulation": "workspace:*",
    "@void-dominion/view3d": "workspace:*",
    "eslint": "^9.39.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  }
}
